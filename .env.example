# Public origin this service is reachable at. The agent card advertises
# $HOST_URL/a2a — if it is wrong, clients that trust the card get a 404.
HOST_URL=http://localhost:4000
PORT=4000

# Octagon's OpenAI-compatible API.
OCTAGON_API_URL=https://api.octagonai.co/v1

# Optional. Fallback credential for local development and single-tenant
# deployments. Leave unset in multi-tenant deployments so every caller must
# present their own key and usage bills against them.
# OCTAGON_API_KEY=

LOG_LEVEL=info
